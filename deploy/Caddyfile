# One domain, three apps. Host-based routing, because each app generates
# absolute paths (/static, /_next, /api) and would break under a path prefix.
#
#   app.example.com       Pramana      — account, research workspace, the hub
#   terminal.example.com  Terminal     — live / paper options trading
#   lab.example.com       Strategy Lab — backtesting and validation
#
# Set on each process so cross-app links and tickets use these names:
#   PRAMANA_PUBLIC_URL=https://app.example.com        (terminal)
#   NEXT_PUBLIC_PRAMANA_URL=https://app.example.com   (lab)
#   PRAMANA_TERMINAL_URL=https://terminal.example.com (pramana)
#   PRAMANA_LAB_URL=https://lab.example.com           (pramana)
# and the same PRAMANA_SSO_SECRET on all three. Caddy provisions TLS itself.

app.example.com      { reverse_proxy 127.0.0.1:8787 }
terminal.example.com { reverse_proxy 127.0.0.1:5010 }
lab.example.com      { reverse_proxy 127.0.0.1:4300 }
