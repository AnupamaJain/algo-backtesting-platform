# One domain, one port. Pramana is the gateway: it serves the workspace and
# proxies /terminal and /lab to the other two processes, which bind to
# loopback and are reachable only through it. Caddy provisions TLS.
#
# Set PRAMANA_SSO_SECRET identically on all three processes.

app.example.com {
  reverse_proxy 127.0.0.1:8787
}
